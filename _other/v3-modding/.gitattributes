* text=auto
*.c text eol=lf
*.h text eol=lf
*.py text eol=lf
*.md text eol=lf
Makefile text eol=lf
# Preserve downloaded snapshots exactly, including original line endings.
vendor/Bing-feeder/** -text -whitespace linguist-vendored
vendor/Microsmt-PNPv3/** -text -whitespace linguist-vendored
# CAD exports are inspected in CAD tools, not as multi-megabyte text diffs.
*.STEP binary
*.STL binary
*.stl binary
*.DWG binary
# Retain raw device transcripts exactly, including their original line endings.
hardware/evidence/** -text -whitespace
